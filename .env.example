# ============================================================
# 图像自动标注系统 - 统一环境变量 (项目根 .env)
# ============================================================
# 这是整个系统唯一的配置入口, 同时供:
#   1) docker-compose 启动所有容器
#   2) 后端 pydantic-settings 加载 (自动从项目根 .env 读取)
#   3) 前端 Vite 构建 (VITE_* 前缀)
#
# 使用方法:
#   1) 复制本文件为 .env (已完成)
#   2) 第一次部署前运行: python scripts/gen_secrets.py 生成所有密钥
#   3) 修改下方 CORS_ORIGINS / HF_ENDPOINT 等部署相关项
#   4) 一键启动:  ./scripts/start_docker.ps1  (Windows)
#                 ./scripts/start_docker.sh   (Linux/macOS)
#
# 重要:
#   - 不要在 git 中提交 (在 .gitignore 中已排除)
#   - 所有带 CHANGEME 标记的密钥必须替换
#   - 至少 32 字符的强随机字符串用于 SECRET_KEY / *_PASSWORD
# ============================================================

# ============================================================
# 1) 应用基础配置
# ============================================================
APP_NAME=Image Annotation System
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================================
# 2) 安全密钥 (生产部署前必须替换, 用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成)
# ============================================================
SECRET_KEY=CHANGEME-replace-with-32-char-random-secret-CHANGEME
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ISSUER=image-annotation
JWT_AUDIENCE=image-annotation-api
JWT_LEEWAY_SECONDS=60

# ============================================================
# 3) MySQL 数据库
# ============================================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=annotation
MYSQL_PASSWORD=CHANGEME-mysql-password-CHANGEME
MYSQL_DATABASE=image_annotation
MYSQL_ROOT_PASSWORD=CHANGEME-mysql-root-password-CHANGEME

# ============================================================
# 4) Redis (Celery Broker + 缓存)
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME-redis-password-CHANGEME
REDIS_DB=0
REDIS_MAXMEMORY=1gb

# ============================================================
# 5) Celery
# ============================================================
# 容器内走服务名, 不要用 127.0.0.1
# 脚本 gen_secrets.py 会自动用 REDIS_PASSWORD 替换 URL 中的 CHANGEME-redis-password-CHANGEME 占位符
CELERY_BROKER_URL=redis://:CHANGEME-redis-password-CHANGEME@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGEME-redis-password-CHANGEME@redis:6379/2
CELERY_WORKER_POOL=threads
CELERY_WORKER_CONCURRENCY=2

# ============================================================
# 6) MinIO / 对象存储
# ============================================================
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGEME-minio-user-CHANGEME
MINIO_SECRET_KEY=CHANGEME-minio-password-CHANGEME
MINIO_BUCKET=image-annotation
MINIO_SECURE=false

# ============================================================
# 7) 文件存储 (容器内绝对路径)
# ============================================================
UPLOAD_DIR=/app/uploads
MODEL_DIR=/app/models
MAX_UPLOAD_SIZE_MB=20

# ============================================================
# 8) 模型推理
# ============================================================
DEFAULT_MODEL=efficientnet_b0
DEFAULT_CONFIDENCE_THRESHOLD=0.6
INFERENCE_DEVICE=cpu

# ============================================================
# 9) HuggingFace 镜像 (国内网络必配)
# ============================================================
HF_ENDPOINT=https://hf-mirror.com
HUGGINGFACE_HUB_ENDPOINT=https://hf-mirror.com
HF_HOME=/app/models/cache/huggingface
HF_HUB_DISABLE_SYMLINKS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_DOWNLOAD_TIMEOUT=60

# ============================================================
# 10) CORS (生产环境改为实际前端域名)
# ============================================================
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=true

# ============================================================
# 11) 前端 Vite 构建期 (仅 docker build 时使用, 运行时由 nginx 反代)
# ============================================================
# 默认空=同源 /api (走 nginx 反代), 前后端分离时填完整 URL
VITE_API_BASE_URL=
VITE_APP_PORT=5173

# ============================================================
# 12) 可选业务配置
# ============================================================
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
REQUEST_SLOW_THRESHOLD_MS=500
SQL_SLOW_THRESHOLD_MS=200
DATALOADER_WORKERS=0
SEG_INFERENCE_BATCH_SIZE=4
