# ===========================================================
# 前端生产环境默认配置
# -----------------------------------------------------------
# 由 Vite 在 `npm run build` 构建时自动加载
# 生产部署前请根据实际部署情况调整后端地址
# ===========================================================

# 前端预览端口（vite preview 启动时使用）
VITE_APP_PORT=6173

# 后端服务地址（仅在 vite.config.ts 中用于 dev proxy；生产构建不使用）
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8000

# 生产环境 API 完整 baseURL
# 默认留空：保持 '/api' 同源，依赖反向代理（Nginx 等）将 /api 转发到后端
# 若前后端分离部署，请填写完整 URL，例如：
#   VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=
