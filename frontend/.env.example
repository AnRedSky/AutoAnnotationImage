# ===========================================================
# 前端环境变量配置模板
# -----------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env 或 .env.local / .env.development / .env.production
#   2. 按需修改下面的值
#   3. .env / .env.*.local 已被 .gitignore 排除，不会被提交
#   4. 只有以 VITE_ 开头的变量才会被 Vite 注入到客户端
# ===========================================================

# ---------- 前端访问端口 ----------
# Vite dev server 监听端口；npm run dev 启动后访问地址 http://127.0.0.1:<端口>/
VITE_APP_PORT=6173

# ---------- 后端服务地址 ----------
# 开发环境通过 Vite proxy 将 /api 前缀的请求转发到后端
# 后端 .env 中 APP_PORT 一致（默认 5000）
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=5000

# ---------- （可选）API 完整 baseURL ----------
# 留空则使用默认 '/api'（依赖 Vite proxy 转发）
# 仅当生产环境需要直连后端（如前后端分离部署）时配置，例如：
#   VITE_API_BASE_URL=http://your-backend-host:5000/api
VITE_API_BASE_URL=
