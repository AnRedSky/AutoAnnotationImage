# ===========================================================
# 前端开发环境默认配置
# -----------------------------------------------------------
# 由 Vite 在 `npm run dev` 启动时自动加载
# 团队成员共享的默认值；如需本地调整请创建 .env.development.local
# ===========================================================

# 前端 dev server 监听端口
VITE_APP_PORT=5173

# 后端服务地址（dev 模式下 /api 通过 Vite proxy 转发到该地址）
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=5000

# 开发环境默认走 proxy，无需配置完整 baseURL
VITE_API_BASE_URL=
