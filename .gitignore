# Python
__pycache__/
*.py[cod]
*.egg-info/
*.so
.Python
venv/
env/
.env

# Node
node_modules/
dist/
.vite/
*.log
.npm

# Frontend 本地环境变量覆盖（仅 .example / .development / .production 提交到 git）
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo
.tmp
.trae/

# Project
uploads/

# 项目根目录的 ML 权重 (历史, 未使用; 后端运行时不会写到这里)
/models/
/models/*.pth
/models/*.onnx
/models/hf_cache/

# 训练产物 (backend/models 目录是 ORM 模型代码 + 训练产物混杂区, 必须精确忽略)
# ORM 模型 (bbox_annotation.py / image.py / segmentation_mask.py / 等) 必须入库
/backend/models/*.pth
/backend/models/*.onnx
/backend/models/*.safetensors
/backend/models/hf_cache/
# 统一预训练权重缓存 (HF_HOME / TORCH_HOME / ULTRALYTICS_HOME)
/backend/models/cache/
# YOLOv8 训练 run 目录 (每次训练一个子目录)
/backend/models/runs/
# DeepLabV3+ 分割训练权重 (state_dict, 落盘于此)
/backend/models/seg_runs/
# 训练用临时数据 (YOLO 数据集导出等)
/backend/models/data/
# 兜底: 整个 backend/models 子目录里只要不是 .py ORM 都忽略
/backend/models/*

# 兜底: 任何位置的模型文件
*.pt
*.pth
*.onnx
*.safetensors

# 分片/断点续传下载的临时文件 (e.g. yolov8x.pt.{hash}.partial 是 HF Hub/Ultralytics 拉权重时的中间产物)
*.partial
*.part
*.crdownload
*.tmp.download

# 图片 (排除前端 public 下的合法资源)
*.jpg
*.png
!frontend/public/


# OS
.DS_Store
Thumbs.db

# 运行产物 (按规范不应纳入版本控制)
backend/backend_log.txt
logs/
*.pid

# 测试覆盖数据 (pytest-cov / coverage.py 跑测生成)
.coverage
.coverage.*
htmlcov/
.tox/
.cache/
