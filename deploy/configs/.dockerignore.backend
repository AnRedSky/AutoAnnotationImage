# ============================================================
#  .dockerignore - 控制 docker build 上下文范围
#  原则: 最小上下文 + 排除敏感 + 排除临时/大文件
# ============================================================

# ----- Python 编译产物 -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
.installed.cfg
*.egg

# ----- 虚拟环境 (镜像内独立 .venv, 不打包宿主机) -----
.venv/
venv/
env/
.venv-*/
.python-version

# ----- 测试与覆盖率 -----
.coverage
.coverage.*
.coverage.cov
htmlcov/
.pytest_cache/
.tox/
.cache/
.ruff_cache/
.mypy_cache/
.pyright/
.pyre/

# ----- 文档/计划 (运行时不需要) -----
docs/
README.md
*.md
LICENSE
CONTRIBUTING.md
CHANGELOG.md

# ----- 日志/临时/进程文件 -----
*.log
*.log.*
*.pid
*.sock
*.tmp
*.swp
*.swo
*.bak
logs/
backend.out.log
backend.err.log
backend.log
celery.log
celery.pid
backend.pid

# ----- 模型/数据 (体量大, 走 volume 挂载) -----
models/
models/cache/
models/runs/
models/seg_runs/
models/data/
uploads/
demo/

# ----- 敏感信息 (绝对不能进镜像) -----
.env
.env.*
!.env.example
.env.prod
.env.local
secrets/
*.pem
*.key
*.crt
id_rsa*
id_dsa*

# ----- IDE / 编辑器 -----
.idea/
.vscode/
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace
*.code-workspace

# ----- 容器与编排自身 (避免递归) -----
.git/
.gitignore
.gitattributes
.dockerignore
Dockerfile*
docker-compose*.yml
compose*.yml
.docker/

# ----- 大体积/历史数据/压缩包 -----
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip
*.7z
*.rar
*.tgz
*.dmg
*.iso
node_modules/

# ----- 数据库 & 备份 -----
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
backups/
