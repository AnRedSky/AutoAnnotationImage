# syntax=docker/dockerfile:1.7
# =====================================================================
#  Worker-only stage — 复用 base, Celery 入口
# ---------------------------------------------------------------------
#  使用方法:
#    docker build --target worker -t annotation/worker:local -f Dockerfile.worker .
#  或 docker-compose 中:
#    build:
#      context: ./backend
#      dockerfile: Dockerfile.worker
#      target: worker
#
#  启动形态 (CMD 通过 compose 或 docker run 覆盖):
#    - train    : --concurrency=1, -Q train
#    - annotate : --concurrency=4, -Q annotate
# =====================================================================

# ============== Stage 1: builder ==============
FROM python:3.10-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /usr/local/bin/

WORKDIR /build
COPY pyproject.toml uv.lock ./

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_COMPILE_BYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# v3.3.1 修复: 添加 --no-dev 排除开发依赖 (mypy/ruff/pytest), 节省 1-3 分钟构建时间
RUN uv sync --frozen --no-install-project --no-dev

# ============== Stage 2: base ==============
FROM python:3.10-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates gosu \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /usr/local/bin/

# v3.3.2 修复: 先建用户, 再 COPY --chown, 消除 chown -R 翻倍层
RUN groupadd -r app && useradd -r -g app -d /app -s /sbin/nologin app \
    && mkdir -p /app/uploads /app/models /app/logs

COPY --chown=app:app --from=builder /app/.venv /app/.venv

WORKDIR /app
COPY --chown=app:app pyproject.toml uv.lock ./
COPY --chown=app:app app /app/app
COPY --chown=app:app scripts /app/scripts
COPY --chown=app:app migrations /app/migrations

# v3.3.2: 入口脚本 — 修复命名卷权限后通过 gosu 降权到 app 用户
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
# 强制清除windows回车符，兜底
RUN sed -i 's/\r$//g' /app/docker-entrypoint.sh \
    && chmod +x /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

ENV PATH="/app/.venv/bin:$PATH" \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_PORT=8000 \
    PYTHONPATH=/app

ENTRYPOINT ["/app/docker-entrypoint.sh"]
EXPOSE 8000

# ============== Stage 3: worker (final) ==============
FROM base AS worker

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD celery -A app.tasks.workers.celery_app inspect ping -d "celery@$(hostname)" \
        --timeout 5 || exit 1

CMD ["celery", \
     "-A", "app.tasks.workers.celery_app", \
     "worker", \
     "--loglevel=info", \
     "--pool=threads", \
     "--concurrency=2", \
     "-Q", "train,annotate"]
