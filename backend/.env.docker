# =============================================
# 图像自动标注系统 - Docker 部署环境变量
# =============================================
# ⚠️  本文件仅作占位符示例, 实际部署时必须替换以下敏感字段:
#   1) SECRET_KEY           (JWT 签名)
#   2) MYSQL_ROOT_PASSWORD  (MySQL root)
#   3) MYSQL_PASSWORD       (MySQL 应用账户)
#   4) REDIS_PASSWORD       (Redis 访问)
#   5) MINIO_ACCESS_KEY     (MinIO 账户)
#   6) MINIO_SECRET_KEY     (MinIO 密码)
#   7) CORS_ORIGINS         (前端域名)
#
# 推荐做法:
#   1) cp .env.docker .env.prod
#   2) 用 sed 替换 / python secrets 替换占位符
#   3) chmod 600 .env.prod
#   4) docker compose --env-file .env.prod up -d
#
# 启动前会校验所有 ${VAR:?msg required} 占位符必须已设置, 否则 compose 拒绝启动
# =============================================

# ----- 应用基础 -----
APP_NAME=Image Annotation System
APP_ENV=production            # development | production (生产必须 production)
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- 安全密钥 (生产请用 `python -c "import secrets; print(secrets.token_urlsafe(32))"` 生成) -----
# 占位符: 启动时必须替换为 32+ 字符随机串
SECRET_KEY=__REPLACE_WITH_RANDOM_32_CHARS__
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# v3.0.0 审查修复: JWT 标准化 (强制 iss/aud 校验)
JWT_ISSUER=image-annotation
JWT_AUDIENCE=image-annotation-api
JWT_LEEWAY_SECONDS=60

# ----- MySQL -----
# ⚠️  生产必须修改, 启动时 validator 拦截默认值
MYSQL_HOST=mysql               # docker compose 服务名 (容器内 DNS 自动解析)
MYSQL_PORT=3306
MYSQL_USER=annotation
MYSQL_PASSWORD=__REPLACE_WITH_STRONG_MYSQL_PWD__
MYSQL_DATABASE=image_annotation
# root 密码, 容器初始化时使用
MYSQL_ROOT_PASSWORD=__REPLACE_WITH_STRONG_MYSQL_ROOT_PWD__

# ----- Redis (Celery Broker + 缓存) -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__REPLACE_WITH_STRONG_REDIS_PWD__
REDIS_DB=0
REDIS_MAXMEMORY=1gb

# ----- Celery -----
# 容器内走服务名, 不要用 127.0.0.1
CELERY_BROKER_URL=redis://:__REPLACE_WITH_STRONG_REDIS_PWD__@redis:6379/1
CELERY_RESULT_BACKEND=redis://:__REPLACE_WITH_STRONG_REDIS_PWD__@redis:6379/2
# pool: solo | threads (Windows/I/O 友好) | prefork (Linux 生产)
CELERY_WORKER_POOL=threads
CELERY_WORKER_CONCURRENCY=2

# ----- MinIO / 对象存储 -----
# ⚠️  生产必须修改 access/secret key
STORAGE_BACKEND=minio  # local | minio

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=__REPLACE_WITH_MINIO_USER__
MINIO_SECRET_KEY=__REPLACE_WITH_MINIO_PWD__
MINIO_BUCKET=image-annotation
MINIO_SECURE=false

# ----- 文件上传 (容器内绝对路径) -----
UPLOAD_DIR=/app/uploads
MODEL_DIR=/app/models
MAX_UPLOAD_SIZE_MB=20

# ----- 模型推理 -----
DEFAULT_MODEL=efficientnet_b0
DEFAULT_CONFIDENCE_THRESHOLD=0.6
INFERENCE_DEVICE=cpu           # cpu | cuda

# ----- HuggingFace 镜像 (国内网络必配) -----
HF_ENDPOINT=https://hf-mirror.com
HUGGINGFACE_HUB_ENDPOINT=https://hf-mirror.com
# HF_HOME: 留空用默认值 (backend/models/cache/huggingface, 见 config.py).
# Docker 部署时由 docker-compose.yml 显式覆盖为 /app/models/cache/huggingface.
# ⚠ 不要在这里写 /app/... 绝对路径, 本地开发会被解析到盘符根 (如 D:\app\...)
#HF_HOME=
HF_HUB_DISABLE_SYMLINKS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_DOWNLOAD_TIMEOUT=60

# ----- CORS -----
# 生产必须改为实际前端域名, 多个用逗号分隔
# 例: https://annotation.example.com
CORS_ORIGINS=https://annotation.example.com
CORS_ALLOW_CREDENTIALS=true
