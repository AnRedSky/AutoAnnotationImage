# 后端环境变量（Docker 部署）
# ==========================================
# 容器内部通过服务名 (mysql/redis/minio) 互相访问
# 与本地开发的 .env 差异: HOST 用服务名, 端口用容器内默认端口

APP_NAME=Image Annotation System
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

SECRET_KEY=please-change-this-to-a-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL (容器内通过服务名访问)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=image_annotation

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=image-annotation
MINIO_SECURE=false

# 路径
UPLOAD_DIR=/app/uploads
MODEL_DIR=/app/models
MAX_UPLOAD_SIZE_MB=20

# ML 默认
DEFAULT_MODEL=efficientnet_b0
DEFAULT_CONFIDENCE_THRESHOLD=0.6
INFERENCE_DEVICE=cpu

# Celery (用 redis 服务名)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
CORS_ORIGINS=*
