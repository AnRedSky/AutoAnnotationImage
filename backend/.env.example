# =============================================
# 图像自动标注系统 - 后端环境变量模板
# 复制本文件为 .env 后填入实际值
# =============================================

# ----- 应用基础 -----
APP_NAME=Image Annotation System
APP_ENV=development            # development | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=5000

# ----- 示例 admin 账号 (v3.1.0 Phase V #3 新增, 部署后请立即修改密码) -----
# 首次部署后用: uv run python scripts/bootstrap_admin.py --username admin --password "YourStrong!Pass1" --email admin@example.com
# 不要直接在这里写密码, 用 bootstrap_admin.py (它会自动跳过创建已存在 admin)
# ADMIN_USERNAME=admin         # 默认 admin (示例)
# ADMIN_PASSWORD=ChangeMe!123  # 生产前必须替换

# ----- 安全密钥 (生产请改为强随机字符串) -----
SECRET_KEY=change-me-to-a-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# v3.0.0 审查修复: JWT 标准化 (强制 iss/aud 校验)
JWT_ISSUER=image-annotation
JWT_AUDIENCE=image-annotation-api
# 时钟漂移容忍 (秒), 默认 60s
JWT_LEEWAY_SECONDS=60

# ----- MySQL -----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3310
MYSQL_USER=root
# 生产必须修改, 启动时 validator 拦截默认值 (root123/root/空)
MYSQL_PASSWORD=root
MYSQL_DATABASE=image_annotation
MYSQL_ROOT_PASSWORD=root

# ----- Redis (Celery Broker + 缓存) -----
REDIS_HOST=127.0.0.1
REDIS_PORT=9770
REDIS_PASSWORD=
REDIS_DB=0

# ----- MinIO / 对象存储 -----
STORAGE_BACKEND=minio  # local | minio

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin@123456
MINIO_BUCKET=image-annotation
MINIO_SECURE=false

# ----- 文件上传 -----
UPLOAD_DIR=./uploads
MODEL_DIR=./models
# 临时训练数据根目录 (默认 MODEL_DIR/data)
#DATA_DIR=./models/data
# 预训练权重统一缓存根目录 (默认 MODEL_DIR/cache, 含 huggingface/torch/ultralytics)
#PRETRAINED_CACHE_DIR=./models/cache
# ----- v3.3.0: 训练产物按任务类型分目录 (默认都在 MODEL_DIR 下) -----
# 分类模型:  {CLASSIFICATION_MODEL_DIR}/{model_name}_best.pth
#CLASSIFICATION_MODEL_DIR=./models/classification
# 检测模型:  {DETECTION_MODEL_DIR}/{model_alias}/weights/{best,last}.pt
#DETECTION_MODEL_DIR=./models/detection
# 分割模型:  {SEGMENTATION_MODEL_DIR}/{model_alias}_{task_id}.pt
#SEGMENTATION_MODEL_DIR=./models/segmentation
MAX_UPLOAD_SIZE_MB=20


# ----- 模型训练 (v3.6.0 性能优化) -----
EARLY_STOP_PATIENCE=100           # 分类训练任务--早停耐心 (评分不变化次数)
# DataLoader 工作进程数 (GPU 训练推荐 2-4, CPU 训练保持 0)
# 0=主进程串行加载 (CPU 默认); >0=多进程并行加载 + pin_memory (GPU 推荐)
DATALOADER_WORKERS=4
# MinIO 训练样本预下载并发数 (信号量限流, 避免打爆 MinIO)
# 1=走旧版串行 (零回归); 2-10=并发 (GPU 训练推荐 10); >20 可能触发 MinIO 限流
MINIO_DOWNLOAD_CONCURRENCY=10
# 训练图像预解码 LRU 缓存大小 (worker 进程级 lru_cache)
# 总内存 = workers × size × per_image, 128 张 224x224×3×4B ≈ 75MB/worker
TRAIN_DECODE_CACHE_SIZE=128


# ----- 模型推理 -----
DEFAULT_MODEL=efficientnet_b0
DEFAULT_CONFIDENCE_THRESHOLD=0.6
INFERENCE_DEVICE=cpu           # cpu | cuda

# ----- HuggingFace 镜像 (国内网络必配) -----
HF_ENDPOINT=https://hf-mirror.com
HUGGINGFACE_HUB_ENDPOINT=https://hf-mirror.com
# HF_HOME: 留空用默认值 (backend/models/cache/huggingface, 见 config.py).
# Docker 部署时由 docker-compose.yml 显式覆盖为 /app/models/cache/huggingface.
# ⚠ 不要在这里写 /app/... 绝对路径, 本地开发会被解析到盘符根 (如 D:\app\...)
#HF_HOME=
HF_HUB_DISABLE_SYMLINKS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_DOWNLOAD_TIMEOUT=60

# ----- Celery -----
CELERY_BROKER_URL=redis://127.0.0.1:9770/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:9770/2
# Worker 并发 (v2.5.15+ 可调, 优先级: CLI --pool/--concurrency > 环境变量 > 此处)
# pool: solo (1 进程 1 任务, 最稳) | threads (1 进程 N 线程, I/O 密集友好) |
#       prefork (Linux only) | gevent (需装 gevent)
# concurrency: solo 池下被忽略, threads 池下为同时跑的线程数
CELERY_WORKER_POOL=threads
CELERY_WORKER_CONCURRENCY=2

# ----- CORS -----
# 开发推荐显式 origin (可与 CORS_ALLOW_CREDENTIALS=true 同时使用)
# Docker/全开放场景可设为 * (此时 credentials 会自动降级为 false)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
