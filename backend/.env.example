# =============================================
# 图像自动标注系统 - 后端环境变量模板
# 复制本文件为 .env 后填入实际值
# =============================================

# ----- 应用基础 -----
APP_NAME=Image Annotation System
APP_ENV=development            # development | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- 安全密钥 (生产请改为强随机字符串) -----
SECRET_KEY=change-me-to-a-random-string-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- MySQL -----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=image_annotation
MYSQL_ROOT_PASSWORD=root

# ----- Redis (Celery Broker + 缓存) -----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ----- MinIO / 对象存储 -----
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=image-annotation
MINIO_SECURE=false

# ----- 文件上传 -----
UPLOAD_DIR=./uploads
MODEL_DIR=./models
MAX_UPLOAD_SIZE_MB=20

# ----- 模型推理 -----
DEFAULT_MODEL=efficientnet_b0
DEFAULT_CONFIDENCE_THRESHOLD=0.6
INFERENCE_DEVICE=cpu           # cpu | cuda

# ----- Celery -----
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ----- CORS -----
CORS_ORIGINS=*
